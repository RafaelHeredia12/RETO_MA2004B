// Pegar TODO esto en la Vista de consultas DAX (4o icono de la izquierda) y dar
// clic en "Actualizar el modelo con cambios". Crea todas las medidas en la tabla Medidas.
// Antes deben existir las tablas Medidas, Moneda y Politica Semaforo.
// Luego "Ejecutar" (F5): la tabla de abajo es una prueba rapida por mes.

DEFINE


    MEASURE Medidas[Ultimo Mes] =
        MAX ( resumen_mensual[MES] )

    MEASURE Medidas[Titulo Periodo] =
        "Cierre de "
            & CALCULATE (
                SELECTEDVALUE ( resumen_mensual[MES_ETIQUETA] ),
                resumen_mensual[MES] = MAX ( resumen_mensual[MES] )
            )

    MEASURE Medidas[Factor Moneda] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN
            IF (
                SELECTEDVALUE ( Moneda[Moneda], "CLP" ) = "MXN",
                CALCULATE ( MAX ( resumen_mensual[TC_MXN_POR_CLP] ), resumen_mensual[MES] = U ),
                1
            )

    MEASURE Medidas[Etiqueta Moneda] =
        SELECTEDVALUE ( Moneda[Moneda], "CLP" )


    // ---------- 2. Conciliación (alerta 1) ----------

    MEASURE Medidas[Saldo GL] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( SUM ( resumen_mensual[SALDO_GL] ), resumen_mensual[MES] = U ) * [Factor Moneda]

    MEASURE Medidas[Total Kardex] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( SUM ( resumen_mensual[TOTAL_KARDEX] ), resumen_mensual[MES] = U ) * [Factor Moneda]

    MEASURE Medidas[Monto Recetario] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( SUM ( resumen_mensual[RECETARIO] ), resumen_mensual[MES] = U ) * [Factor Moneda]

    MEASURE Medidas[Kardex mas Recetario] =
        [Total Kardex] + [Monto Recetario]

    MEASURE Medidas[Diferencia Kardex vs GL] =
        [Total Kardex] - [Saldo GL]

    MEASURE Medidas[Diferencia No Explicada] =
        [Kardex mas Recetario] - [Saldo GL]

    MEASURE Medidas[% Discrepancia] =
        DIVIDE ( [Diferencia No Explicada], [Saldo GL] )

    MEASURE Medidas[% Diferencia antes de Recetario] =
        DIVIDE ( [Diferencia Kardex vs GL], [Saldo GL] )

    MEASURE Medidas[Estado Conciliacion] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( SELECTEDVALUE ( resumen_mensual[ESTADO_CONCILIACION] ), resumen_mensual[MES] = U )

    MEASURE Medidas[Semaforo Conciliacion] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( SELECTEDVALUE ( resumen_mensual[SEMAFORO_CONCILIACION] ), resumen_mensual[MES] = U )

    MEASURE Medidas[Color Conciliacion] =
        SWITCH ( [Semaforo Conciliacion], "VERDE", "#0CA30C", "ÁMBAR", "#FAB219", "ROJO", "#D03B3B", "#8A8A85" )


    // ---------- 3. Variación mensual (alerta 2) ----------

    MEASURE Medidas[Variacion Mensual %] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( SELECTEDVALUE ( resumen_mensual[VARIACION_PCT] ), resumen_mensual[MES] = U )

    MEASURE Medidas[Alerta Variacion] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( SELECTEDVALUE ( resumen_mensual[ALERTA_VARIACION] ), resumen_mensual[MES] = U )

    MEASURE Medidas[Color Variacion] =
        IF ( ABS ( [Variacion Mensual %] ) >= 0.05, "#D03B3B", "#0CA30C" )

    MEASURE Medidas[Umbral Variacion] =
        0.05


    // ---------- 4. Inventario y antigüedad (alerta 3 y KPIs) ----------

    MEASURE Medidas[Valor Inventario] =
        VAR U = MAX ( partidas[MES] )
        VAR MonedaSel = SELECTEDVALUE ( Moneda[Moneda], "CLP" )
        RETURN
            CALCULATE (
                IF ( MonedaSel = "MXN", SUM ( partidas[VALORIZACION_MXN] ), SUM ( partidas[VALORIZACION] ) ),
                partidas[MES] = U
            )

    MEASURE Medidas[Total Partidas] =
        VAR U = MAX ( partidas[MES] )
        RETURN CALCULATE ( COUNTROWS ( partidas ), partidas[MES] = U )

    MEASURE Medidas[SKUs Unicos] =
        VAR U = MAX ( partidas[MES] )
        RETURN CALCULATE ( DISTINCTCOUNT ( partidas[CODIGO] ), partidas[MES] = U )

    MEASURE Medidas[Partidas Mas 1 Anio] =
        CALCULATE ( [Total Partidas], partidas[MAS_1_ANIO] = 1 )

    MEASURE Medidas[Valor Mas 1 Anio] =
        CALCULATE ( [Valor Inventario], partidas[MAS_1_ANIO] = 1 )

    MEASURE Medidas[% Valor Mas 1 Anio] =
        DIVIDE ( [Valor Mas 1 Anio], [Valor Inventario] )

    MEASURE Medidas[Partidas Riesgo Alto] =
        CALCULATE ( [Total Partidas], partidas[RIESGO_POLITICA] = "RIESGO ALTO" )

    MEASURE Medidas[Valor Riesgo Alto] =
        CALCULATE ( [Valor Inventario], partidas[RIESGO_POLITICA] = "RIESGO ALTO" )

    // Semáforo según la política elegida en el segmentador "Politica Semaforo"
    MEASURE Medidas[Partidas Rojo] =
        IF (
            SELECTEDVALUE ( 'Politica Semaforo'[Politica], "Días (hoja de criterios)" ) = "Días (hoja de criterios)",
            CALCULATE ( [Total Partidas], partidas[SEMAFORO_DIAS] = "ROJO" ),
            CALCULATE ( [Total Partidas], partidas[SEMAFORO_MESES] = "ROJO" )
        )

    MEASURE Medidas[Partidas Ambar] =
        IF (
            SELECTEDVALUE ( 'Politica Semaforo'[Politica], "Días (hoja de criterios)" ) = "Días (hoja de criterios)",
            CALCULATE ( [Total Partidas], partidas[SEMAFORO_DIAS] = "ÁMBAR" ),
            CALCULATE ( [Total Partidas], partidas[SEMAFORO_MESES] = "ÁMBAR" )
        )

    MEASURE Medidas[Partidas Verde] =
        IF (
            SELECTEDVALUE ( 'Politica Semaforo'[Politica], "Días (hoja de criterios)" ) = "Días (hoja de criterios)",
            CALCULATE ( [Total Partidas], partidas[SEMAFORO_DIAS] = "VERDE" ),
            CALCULATE ( [Total Partidas], partidas[SEMAFORO_MESES] = "VERDE" )
        )

    MEASURE Medidas[Valor Rojo] =
        IF (
            SELECTEDVALUE ( 'Politica Semaforo'[Politica], "Días (hoja de criterios)" ) = "Días (hoja de criterios)",
            CALCULATE ( [Valor Inventario], partidas[SEMAFORO_DIAS] = "ROJO" ),
            CALCULATE ( [Valor Inventario], partidas[SEMAFORO_MESES] = "ROJO" )
        )

    MEASURE Medidas[% Valor Rojo] =
        DIVIDE ( [Valor Rojo], [Valor Inventario] )

    // Comparación directa de las dos políticas (no depende del segmentador)
    MEASURE Medidas[Rojo Politica Dias] =
        CALCULATE ( [Total Partidas], partidas[SEMAFORO_DIAS] = "ROJO" )

    MEASURE Medidas[Rojo Politica Meses] =
        CALCULATE ( [Total Partidas], partidas[SEMAFORO_MESES] = "ROJO" )

    MEASURE Medidas[Dias Promedio Antiguedad] =
        VAR U = MAX ( partidas[MES] )
        RETURN CALCULATE ( AVERAGE ( partidas[DIAS_ANTIG] ), partidas[MES] = U )


    // ---------- 5. Alertas ----------

    MEASURE Medidas[Alertas] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( COUNTROWS ( alertas ), alertas[MES] = U )

    MEASURE Medidas[Alertas Nivel Alto] =
        CALCULATE ( [Alertas], alertas[NIVEL] = "ALTO" )

    MEASURE Medidas[Alertas Nivel Medio] =
        CALCULATE ( [Alertas], alertas[NIVEL] = "MEDIO" )

    MEASURE Medidas[Valor en Alerta] =
        VAR U = MAX ( resumen_mensual[MES] )
        RETURN CALCULATE ( SUM ( alertas[VALOR_CLP] ), alertas[MES] = U, alertas[TIPO_ALERTA] = "3. Antigüedad" ) * [Factor Moneda]


    // ---------- 6. Calidad y validación ----------

    MEASURE Medidas[Partidas Conversion] =
        CALCULATE ( [Total Partidas], partidas[ALERTA_CONVERSION] <> "OK" )

    // Fecha de compra que retrocedió respecto al mes anterior (o que se arrastra): posible error de captura
    MEASURE Medidas[Partidas Fecha Sospechosa] =
        CALCULATE ( [Total Partidas], partidas[FULCOM_SOSPECHOSA] = 1 )

    MEASURE Medidas[Valor Fecha Sospechosa] =
        CALCULATE ( [Valor Inventario], partidas[FULCOM_SOSPECHOSA] = 1 )

    MEASURE Medidas[% Coincidencia con Excel] =
        DIVIDE ( SUM ( validacion[COINCIDEN] ), SUM ( validacion[PARTIDAS] ) )


    // ---------- 7. Transiciones (vista previa del modelo de Markov) ----------

    // % de SKUs que, estando en un rango, pasan al rango de la columna en el mes siguiente
    MEASURE Medidas[Probabilidad Transicion] =
        DIVIDE (
            COUNTROWS ( transiciones ),
            CALCULATE ( COUNTROWS ( transiciones ), REMOVEFILTERS ( transiciones[RANGO_SIGUIENTE], transiciones[RANGO_SIGUIENTE_ORDEN] ) )
        )

EVALUATE
SUMMARIZECOLUMNS (
    resumen_mensual[MES_ORDEN],
    resumen_mensual[MES_ETIQUETA],
    "Saldo GL", [Saldo GL],
    "Total Kardex", [Total Kardex],
    "Dif no explicada", [Diferencia No Explicada],
    "Estado", [Estado Conciliacion],
    "Variacion", [Variacion Mensual %],
    "Partidas", [Total Partidas],
    "Mas de 1 anio", [Partidas Mas 1 Anio],
    "Riesgo alto", [Partidas Riesgo Alto]
)
ORDER BY resumen_mensual[MES_ORDEN]
